<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.camunda</groupId>
    <artifactId>camunda-release-parent</artifactId>
    <version>4.1.1</version>
    <!-- do not remove empty tag - http://jira.codehaus.org/browse/MNG-4687 -->
    <relativePath/>
  </parent>

  <groupId>io.camunda.connector.sap</groupId>
  <artifactId>connectors-sap-parent</artifactId>
  <version>8.8.8-SNAPSHOT</version>
  <packaging>pom</packaging>
  <modules>
    <module>rfc-connector</module>
    <module>odata-connector</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <version.slf4j>2.0.20</version.slf4j>
    <!-- also controls the camunda/connectors base image tag used by odata-connector/Dockerfile (see CAMUNDA_CONNECTORS_VERSION build-arg wired up in CI) -->
    <version.camunda>8.8.26</version.camunda>
    <version.cloud-sdk>5.35.0</version.cloud-sdk>
    <version.assertj>3.27.7</version.assertj>
    <version.junit-jupiter>5.14.4</version.junit-jupiter>
    <version.mockito>5.24.0</version.mockito>
    <version.testcontainers>2.0.5</version.testcontainers>
    <plugin.version.spotless-maven-plugin>3.10.3</plugin.version.spotless-maven-plugin>
    <!-- CVE-2026-110879 -->
    <version.jackson>2.22.4</version.jackson>
    <!-- CVE-2026-110879 -->
    <version.jackson3-databind>3.1.8</version.jackson3-databind>
    <version.guava>33.7.2-jre</version.guava>
    <!-- CVE-2026-101356, CVE-2026-101296, CVE-2026-103119, CVE-2026-88041, CVE-2026-93446, CVE-2026-74048 -->
    <version.tomcat-embed>11.0.27</version.tomcat-embed>
    <!-- CVE-2026-93879: restore the version the connector runtime BOM downgrades to 9.1.3.Final -->
    <version.hibernate-validator>9.1.5.Final</version.hibernate-validator>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${version.jackson}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Jackson 3.x (tools.jackson.core groupId) pulled in transitively alongside the 2.x line -->
      <!-- CVE-2026-110879 -->
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${version.jackson3-databind}</version>
      </dependency>

      <!-- CVE-2026-101356, CVE-2026-101296, CVE-2026-103119, CVE-2026-88041, CVE-2026-93446, CVE-2026-74048 -->
      <!-- NOTE: these tomcat-embed/hibernate-validator pins (and the jackson ones above) only take effect for
           rfc-connector's self-contained WAR. odata-connector's shipped Docker image copies just the connector
           jar onto the camunda/connectors base image (see odata-connector/Dockerfile), so its own Tomcat/
           Hibernate Validator/log4j/jakarta.validation classes always come from that base image, unaffected by
           this dependencyManagement. Fixing CVEs sourced from the base image requires bumping version.camunda
           (and thus the base image tag) to a release that bundles patched versions, then re-verifying the
           resulting image. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${version.tomcat-embed}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${version.tomcat-embed}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${version.tomcat-embed}</version>
      </dependency>

      <!-- CVE-2026-93879: restore the version the connector runtime BOM downgrades to 9.1.3.Final -->
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>${version.hibernate-validator}</version>
      </dependency>

    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${plugin.version.spotless-maven-plugin}</version>
          <configuration>
            <formats>
              <format>
                <includes>
                  <include>.gitignore</include>
                </includes>
                <trimTrailingWhitespace/>
                <endWithNewline/>
                <indent>
                  <spaces>true</spaces>
                  <spacesPerTab>2</spacesPerTab>
                </indent>
              </format>
            </formats>
            <java>
              <googleJavaFormat/>
              <removeUnusedImports/>
              <replace>
                <name>keepCoolSrcComment</name>
                <search>// &gt;</search>
                <replacement>//&gt;</replacement>
              </replace>
            </java>
            <pom>
              <sortPom>
                <expandEmptyElements>false</expandEmptyElements>
                <predefinedSortOrder>custom_1</predefinedSortOrder>
              </sortPom>
            </pom>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
